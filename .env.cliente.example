# Variáveis da instalação no servidor do cliente (docker-compose.cliente.yml).
# Copie para .env.cliente e preencha. Esse arquivo contém segredos: não commite.

# --- Banco (Postgres do próprio compose) ---
POSTGRES_DB=admitte
POSTGRES_USER=admitte
# Use letras e números (a senha entra na URL de conexão). Gere uma forte:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Aplicação ---
PORT=3001
# Endereço público (HTTPS) usado nos links dos e-mails. Ex.: https://rh.cliente.com.br
APP_URL=
# Atrás de proxy reverso (Caddy/Nginx/Traefik): 1
TRUST_PROXY=1
# Segredos ESTÁVEIS (mín. 16 caracteres cada; gere com: openssl rand -hex 32).
# Trocá-los invalida URLs de arquivo emitidas / exige reconfigurar o MFA.
ARQUIVOS_SEGREDO=
MFA_CHAVE=
# 1 = verificação em duas etapas obrigatória para toda a equipe
MFA_OBRIGATORIO=1

# --- Conta master (dono da plataforma) e API de integração ---
MASTER_EMAIL=
MASTER_SENHA=
API_KEY_ADMISSOES=

# --- Armazenamento dos PDFs: local (volume do servidor, padrao) ou s3 ---
# Para S3/MinIO/R2: ARMAZENAMENTO_DRIVER=s3 e preencha as variaveis S3_*.
# Com S3 todas as replicas da aplicacao enxergam os mesmos arquivos.
ARMAZENAMENTO_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIXO=

# --- Marca do cliente (opcional) ---
MARCA_NOME=
MARCA_LOGO_URL=
MARCA_COR=
MARCA_COR_ESCURA=

# --- E-mail (SMTP). Sem isto os e-mails são só simulados no log ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=

# --- LGPD ---
RETENCAO_DIAS=365
