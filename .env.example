# Credenciais do projeto Supabase (Project Settings > API Keys). Sem URL e
# chave, o servidor não inicia. Nunca versione o .env com valores reais.
SUPABASE_URL=
# Chave SECRET/service_role: só no servidor, nunca no navegador nem no Git. Com
# ela o RLS fica ligado e a chave pública não acessa nada (supabase/ativar_rls.sql).
SUPABASE_SERVICE_KEY=
# Chave pública (anon/publishable). Opcional: só vale se SUPABASE_SERVICE_KEY
# estiver vazia (modo de desenvolvimento, com aviso no log). Use-a em
# `npm run verificar:rls` para conferir que ela não acessa o banco.
SUPABASE_KEY=

# Porta em que o servidor escuta. Plataformas de deploy em nuvem (Render,
# Railway, etc.) injetam essa variável automaticamente; em execução local ela
# é opcional (padrão: 3001).
PORT=3001

# Client ID OAuth 2.0 do Google (Google Cloud Console > APIs e Serviços >
# Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web"), necessário
# para o botão "Entrar com o Google" (Google Identity Services) funcionar.
# Sem esta variável, o botão aparece desabilitado no login. Origens autorizadas:
# http://localhost:3001 e o domínio da Vercel (passo a passo no README).
GOOGLE_CLIENT_ID=

# Defina como 1 se o servidor roda atrás de um proxy reverso (Render, Railway,
# nginx...) para que o IP do cliente seja lido corretamente. Na Vercel já é
# automático.
TRUST_PROXY=

# Senha da conta de RH de testes (rh@onboarding.local), semeada no boot.
# Opcional: se ficar vazia, vale a senha padrão pública (onboarding123,
# documentada no README, para que qualquer pessoa possa testar). Definindo um
# valor aqui, ele passa a valer também para uma conta de RH já existente.
SENHA_RH_TESTE=

# Onde ficam os PDFs dos candidatos: "local" (pasta uploads/, padrão) ou
# "supabase" (bucket privado do Supabase Storage; persiste na Vercel).
ARMAZENAMENTO_DRIVER=
# Nome do bucket privado (driver supabase). Padrão: documentos
ARMAZENAMENTO_BUCKET=
# Segredo (16+ caracteres) que assina as URLs temporárias de acesso aos PDFs.
ARQUIVOS_SEGREDO=

# Em produção, /testes.html (bateria de testes da interface) fica oculto. Defina
# EXPOR_TESTES=1 apenas num ambiente de demonstração que precise dele.
# EXPOR_TESTES=

# Pasta onde o servidor grava arquivos locais (uploads/, auditoria, planilha).
# Padrão: a pasta do projeto (ou /tmp na Vercel). Use um volume persistente
# em servidor próprio.
DIRETORIO_DADOS=

# Limites de taxa (por processo). Valores padrão entre parênteses.
# LIMITE_CADASTROS_HORA=20   cadastros por IP, por hora
# LIMITE_ATIVACOES_15MIN=30  ativações de conta por IP, a cada 15 min
# LIMITE_FICHAS_HORA=30      fichas criadas por usuário (ou IP), por hora
# LIMITE_UPLOADS_HORA=120    documentos enviados por usuário, por hora
# LIMITE_MENSAGENS_10MIN=60  mensagens de chat por usuário, a cada 10 min

# Chave da API REST v1 (GET /api/v1/admissoes), enviada no header "x-api-key".
# Obrigatória para usar a API (mín. 16 caracteres, valor longo e aleatório);
# se ficar vazia, a API responde 503 - não existe chave padrão.
API_KEY_ADMISSOES=

# Conta MASTER (dono da plataforma): criada no boot a partir destas variáveis.
# Senha com 12+ caracteres, letras e números. Sem elas, a conta não existe.
# Acesso em /master.html (cria as contas admin dos clientes).
MASTER_EMAIL=
MASTER_SENHA=

# Endereço público do sistema, usado nos links dos e-mails (recuperação de
# senha, acesso inicial, ativação). Ex.: https://rh.suaempresa.com.br
APP_URL=

# Envio de e-mail (SMTP). Sem isto o envio é SIMULADO no log do servidor.
# Use SMTP_URL (ex.: smtps://usuario:senha@smtp.exemplo.com:465) OU os campos abaixo.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=
# LIMITE_RECUPERACOES_HORA=5      pedidos de recuperação por IP+e-mail, por hora
# LIMITE_CONTAS_CRIADAS_HORA=60   contas criadas pelo master/admin, por hora

# LGPD: direitos do titular e retencao
# RETENCAO_DIAS=365           fichas de NAO contratados (reprovados/em analise, fora do
#                             Banco de Talentos) sem atualizacao ha mais de N dias podem
#                             ser anonimizadas em /titulares.html (admin: simular e executar)
# LIMITE_TITULAR_HORA=10      exportacoes/pedidos de exclusao por usuario, por hora

# Hospedagem serverless que nao seja a Vercel (Netlify, Lambda...): 1\n# A Vercel e detectada sozinha. Detalhes em lib/plataforma.js\n# SERVERLESS=1\n\n# Armazenamento S3-compativel (AWS S3, MinIO, Cloudflare R2...). Use com ARMAZENAMENTO_DRIVER=s3
# S3_BUCKET=admitte
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=sa-east-1
# S3_ENDPOINT=https://minio.suaempresa.com   (vazio = AWS S3)
# S3_PREFIXO=admitte/                        (pasta dentro do bucket, opcional)
# S3_SSE=AES256                              (criptografia em repouso no S3, opcional)

# Limites de tentativas compartilhados entre instancias (padrao: ligado, usa o banco).
# 0 = contador em memoria de cada processo. Exige supabase/migracao_limites.sql no Supabase.
# LIMITES_COMPARTILHADOS=0

# Banco de dados: supabase (padrao) ou postgres (banco proprio do cliente)
# BANCO_DRIVER=postgres
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# PGSSL=1                        liga TLS na conexao com o banco
# Instalacao completa no servidor do cliente: docker-compose.cliente.yml e .env.cliente.example

# Marca (white-label): nome, logo e cores desta instalacao
# MARCA_NOME=Admitte                nome exibido nas telas, e-mails, PDFs e termos
# MARCA_LOGO_URL=/marca/logo.svg    logo: caminho dentro de public/ OU https://... (svg, png, jpg, webp)
# MARCA_COR=#00A335                 cor de acao (botoes e destaques), formato #RRGGBB
# MARCA_COR_ESCURA=#0F3D2A          cor escura (titulos e painel), formato #RRGGBB

# Verificacao em duas etapas (MFA/TOTP) para rh, admin e master
# MFA_OBRIGATORIO=1           exige MFA para toda a equipe (padrao: opcional)
# MFA_CHAVE=                  segredo ESTAVEL que cifra os segredos TOTP (min. 16 caracteres).
#                             Trocar invalida os MFA ja configurados (use o reset do admin)
# LIMITE_MFA_15MIN=30         tentativas de MFA por IP, a cada 15 minutos